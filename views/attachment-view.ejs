<div class="space-y-8 animate-fadeIn max-w-4xl mx-auto py-8">
    <a href="/tickets" class="inline-flex items-center gap-2 text-gray-500 hover:text-indigo-600 font-medium transition">← Back to Tickets</a>
    
    <div class="bg-white rounded-3xl shadow-xl overflow-hidden border border-gray-100">
        <div class="bg-gradient-to-r from-indigo-600 to-purple-600 p-8 text-white">
            <p class="text-indigo-200 text-sm">Attachment</p>
            <h1 class="text-3xl font-black"><%= attachment.filename %></h1>
        </div>
        <div class="p-8">
            <div class="bg-gray-900 rounded-2xl p-8 font-mono text-green-400 text-sm leading-relaxed min-h-[200px] flex items-center justify-center">
                <div class="text-center">
                    <p class="text-6xl mb-4">📄</p>
                    <p class="text-xl font-bold text-white mb-2"><%= attachment.filename %></p>
                    <p class="text-green-300 break-all"><%= attachment.file_content %></p>
                    <div class="mt-4 pt-4 border-t border-gray-700 text-gray-500 text-xs">
                        Attachment ID: <%= attachment.id %> | User ID: <%= attachment.user_id %>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>