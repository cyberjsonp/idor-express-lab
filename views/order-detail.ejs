<div class="space-y-8 animate-fadeIn max-w-4xl mx-auto py-8">
    <a href="/orders" class="inline-flex items-center gap-2 text-gray-500 hover:text-indigo-600 font-medium transition">← Back to Orders</a>
    
    <div class="bg-white rounded-3xl shadow-xl overflow-hidden border border-gray-100">
        <div class="bg-gradient-to-r from-indigo-600 to-purple-600 p-8 text-white">
            <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
                <div><p class="text-indigo-200 text-sm">Order Details</p><h1 class="text-3xl font-black">#ORD-<%= String(order.id).padStart(3,'0') %></h1></div>
                <span class="px-4 py-2 rounded-full text-sm font-bold <%= order.status==='classified'?'bg-red-500 animate-pulse':'bg-white/20' %>"><%= order.status %></span>
            </div>
        </div>
        <div class="p-8 grid grid-cols-1 md:grid-cols-2 gap-8">
            <div class="space-y-4">
                <h3 class="font-bold text-gray-900 text-lg">📋 Information</h3>
                <div class="bg-gray-50 rounded-xl p-5 space-y-3">
                    <div class="flex justify-between"><span class="text-gray-500">Product</span><span class="font-bold"><%= order.product %></span></div>
                    <div class="flex justify-between"><span class="text-gray-500">Customer</span><span class="font-bold flex items-center gap-2"><span class="w-6 h-6 bg-indigo-100 rounded-full flex items-center justify-center text-xs font-bold text-indigo-600"><%= order.owner_name.charAt(0).toUpperCase() %></span>@<%= order.owner_name %></span></div>
                </div>
            </div>
            <div class="space-y-4">
                <h3 class="font-bold text-gray-900 text-lg">📝 Details</h3>
                <div class="bg-gradient-to-br from-indigo-50 to-purple-50 rounded-xl p-6 border-2 border-indigo-100 min-h-[100px] flex items-center">
                    <p class="text-gray-800 text-lg font-medium"><%= order.details %></p>
                </div>
            </div>
        </div>
    </div>

    <% if (order.owner_name !== user.username) { %>
    <div class="bg-amber-50 border-2 border-amber-300 rounded-2xl p-6 flex gap-4">
        <span class="text-4xl">⚠️</span>
        <div><h3 class="font-black text-amber-800 text-lg">IDOR Detected!</h3><p class="text-amber-700">You're viewing <strong>@<%= order.owner_name %>'s</strong> order. This is an <strong>Insecure Direct Object Reference</strong> vulnerability. Find the flag in the CTF Lab!</p></div>
    </div>
    <% } %>
</div>