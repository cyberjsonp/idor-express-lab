<div class="space-y-8 animate-fadeIn max-w-5xl mx-auto py-8">
    <div>
        <h1 class="text-4xl font-black text-gray-900 mb-2">📁 Shared Files</h1>
        <p class="text-gray-500">Files you own and files shared with you</p>
    </div>

    <% if (typeof success !== 'undefined' && success) { %><div class="bg-green-50 border-l-4 border-green-500 text-green-700 p-4 rounded-xl"><span>✅</span> <%= success %></div><% } %>
    <% if (typeof error !== 'undefined' && error) { %><div class="bg-red-50 border-l-4 border-red-500 text-red-700 p-4 rounded-xl"><span>❌</span> <%= error %></div><% } %>

    <!-- My Files -->
    <div class="bg-white rounded-2xl shadow-lg p-8 border border-gray-100">
        <h2 class="text-2xl font-black text-gray-900 mb-6">📂 My Files</h2>
        <% if (myFiles.length === 0) { %>
        <p class="text-gray-500">No files uploaded yet.</p>
        <% } else { %>
        <div class="space-y-3">
            <% myFiles.forEach(function(file) { %>
            <div class="flex items-center justify-between bg-gray-50 rounded-xl p-4 border border-gray-200 hover:bg-indigo-50 transition">
                <div class="flex items-center gap-3">
                    <span class="text-3xl">📄</span>
                    <div>
                        <p class="font-bold text-gray-900"><%= file.filename %></p>
                        <p class="text-xs text-gray-400 font-mono">
                            GUID: <%= file.guid.substring(0, 8) %>... 
                            <span class="text-amber-600">(only first 8 chars shown)</span>
                        </p>
                    </div>
                </div>
                <a href="/share/<%= file.guid %>" class="px-4 py-2 bg-indigo-600 text-white rounded-xl font-bold text-sm hover:bg-indigo-700 transition">🔍 Open</a>
            </div>
            <% }); %>
        </div>
        <% } %>
    </div>

    <!-- Shared With Me -->
    <div class="bg-white rounded-2xl shadow-lg p-8 border border-gray-100">
        <h2 class="text-2xl font-black text-gray-900 mb-6">🤝 Shared With Me</h2>
        <% if (sharedWithMe.length === 0) { %>
        <p class="text-gray-500">No files shared with you yet.</p>
        <% } else { %>
        <div class="space-y-3">
            <% sharedWithMe.forEach(function(file) { %>
            <div class="flex items-center justify-between bg-purple-50 rounded-xl p-4 border border-purple-200 hover:bg-purple-100 transition">
                <div class="flex items-center gap-3">
                    <span class="text-3xl">📄</span>
                    <div>
                        <p class="font-bold text-gray-900"><%= file.filename %></p>
                        <p class="text-xs text-gray-500">Shared by: @<%= file.owner_name %></p>
                        <p class="text-xs text-gray-400 font-mono">GUID: <%= file.guid.substring(0, 8) %>...</p>
                    </div>
                </div>
                <a href="/share/<%= file.guid %>" class="px-4 py-2 bg-purple-600 text-white rounded-xl font-bold text-sm hover:bg-purple-700 transition">🔍 Open</a>
            </div>
            <% }); %>
        </div>
        <% } %>
    </div>

    <!-- IDOR Hint -->
    <div class="bg-amber-50 border border-amber-200 rounded-2xl p-5 flex gap-3">
        <span class="text-2xl">💡</span>
        <div>
            <h4 class="font-bold text-amber-800 mb-1">Testing Tip</h4>
            <p class="text-amber-700 text-sm">
                Only the <strong>first 8 characters</strong> of the GUID are shown here. 
                But what happens when you <strong>add a comment</strong> on a file? 
                Check the server response carefully... 🔍
            </p>
        </div>
    </div>
</div>