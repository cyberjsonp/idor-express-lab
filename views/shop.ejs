<div class="space-y-8 animate-fadeIn max-w-6xl mx-auto py-8">
    <div>
        <h1 class="text-4xl font-black text-gray-900 mb-2">🛍️ Shop</h1>
        <p class="text-gray-500">Browse our premium electronics collection</p>
    </div>

    <% if (typeof success !== 'undefined' && success) { %><div class="bg-green-50 border-l-4 border-green-500 text-green-700 p-4 rounded-xl"><span>✅</span> <%= success %></div><% } %>
    <% if (typeof error !== 'undefined' && error) { %><div class="bg-red-50 border-l-4 border-red-500 text-red-700 p-4 rounded-xl"><span>❌</span> <%= error %></div><% } %>

    <!-- Products Grid -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        <% products.forEach(function(product) { %>
        <div class="bg-white rounded-2xl shadow-lg hover:shadow-xl transition-all duration-300 hover:-translate-y-1 overflow-hidden border border-gray-100 group">
            <div class="h-48 bg-gradient-to-br from-indigo-50 to-purple-50 flex items-center justify-center text-7xl group-hover:scale-110 transition-transform duration-500"><%= product.image_emoji %></div>
            <div class="p-5">
                <h3 class="text-lg font-bold text-gray-900"><%= product.name %></h3>
                <p class="text-gray-500 text-sm mt-1"><%= product.description %></p>
                <div class="flex items-center justify-between mt-4">
                    <span class="text-2xl font-black text-gray-900">$<%= product.price.toFixed(0) %></span>
                    <button onclick="buyNow(<%= product.id %>, <%= product.price %>)" class="px-4 py-2 bg-gradient-to-r from-indigo-600 to-purple-600 text-white rounded-xl font-bold text-sm hover:shadow-lg transition">🛒 Buy Now</button>
                </div>
            </div>
        </div>
        <% }); %>
    </div>

    <!-- Checkout Modal (Hidden by default) -->
    <div id="checkout-modal" class="hidden fixed inset-0 z-50 flex items-center justify-center bg-black/50 backdrop-blur-sm p-4">
        <div class="bg-white rounded-3xl shadow-2xl p-8 max-w-lg w-full animate-slideUp">
            <h2 class="text-2xl font-black text-gray-900 mb-4">🛒 Checkout</h2>
            <div id="checkout-product-info" class="mb-4"></div>
            
            <form id="checkout-form" class="space-y-4">
                <div>
                    <label class="block text-sm font-bold text-gray-700 mb-2">📫 Shipping Address</label>
                    <select name="shipping_address_id" id="address-select" class="w-full px-4 py-3 border-2 border-gray-200 rounded-xl focus:border-indigo-500 outline-none transition" required>
                        <option value="">Select an address...</option>
                        <% addresses.forEach(function(addr) { %>
                        <option value="<%= addr.id %>"><%= addr.label %> - <%= addr.full_address %> (ID: <%= addr.id %>)</option>
                        <% }); %>
                    </select>
                </div>
                <div>
                    <label class="block text-sm font-bold text-gray-700 mb-2">🎫 Coupon Code</label>
                    <input type="text" name="coupon" id="coupon-input" class="w-full px-4 py-3 border-2 border-gray-200 rounded-xl focus:border-indigo-500 outline-none transition" placeholder="e.g. SAVE10">
                </div>
                <div class="flex gap-3">
                    <button type="button" onclick="document.getElementById('checkout-modal').classList.add('hidden')" class="flex-1 px-4 py-3 bg-gray-100 text-gray-700 rounded-xl font-bold hover:bg-gray-200 transition">Cancel</button>
                    <button type="button" onclick="submitCheckout()" class="flex-1 px-4 py-3 bg-gradient-to-r from-indigo-600 to-purple-600 text-white rounded-xl font-bold hover:shadow-lg transition">💳 Pay Now</button>
                </div>
            </form>
        </div>
    </div>

    <!-- Result Modal -->
    <div id="result-modal" class="hidden fixed inset-0 z-50 flex items-center justify-center bg-black/50 backdrop-blur-sm p-4">
        <div class="bg-white rounded-3xl shadow-2xl p-8 max-w-lg w-full animate-slideUp">
            <div id="result-content"></div>
            <button onclick="document.getElementById('result-modal').classList.add('hidden')" class="mt-6 w-full px-4 py-3 bg-indigo-600 text-white rounded-xl font-bold hover:bg-indigo-700 transition">OK</button>
        </div>
    </div>

    <!-- IDOR Hint -->
    <div class="bg-amber-50 border border-amber-200 rounded-2xl p-5 flex gap-3">
        <span class="text-2xl">💡</span>
        <div>
            <h4 class="font-bold text-amber-800 mb-1">Testing Tip</h4>
            <p class="text-amber-700 text-sm">
                The <code class="bg-amber-100 px-1.5 py-0.5 rounded text-amber-800 font-mono text-xs">shipping_address_id</code> is sent in the POST body, not the URL. 
                Try intercepting the request and changing it to an address ID that belongs to another user!
            </p>
        </div>
    </div>
</div>

<script>
let currentProductId = null;
let currentProductPrice = 0;

function buyNow(productId, price) {
    currentProductId = productId;
    currentProductPrice = price;
    document.getElementById('checkout-modal').classList.remove('hidden');
}

async function submitCheckout() {
    const addressId = document.getElementById('address-select').value;
    const coupon = document.getElementById('coupon-input').value;
    
    if (!addressId) { alert('Please select an address'); return; }
    
    try {
        const r = await fetch('/api/checkout', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({
                product_id: currentProductId,
                shipping_address_id: parseInt(addressId),
                coupon: coupon || null
            })
        });
        const d = await r.json();
        
        document.getElementById('checkout-modal').classList.add('hidden');
        
        let html = '';
        if (d.success) {
            html = `<div class="text-center"><div class="text-6xl mb-4">✅</div><h3 class="text-2xl font-black text-gray-900 mb-2">Order Confirmed!</h3><p class="text-gray-600">${d.order.product}</p><div class="bg-gray-50 rounded-xl p-4 mt-4 text-left"><p class="text-sm"><strong>Shipping to:</strong> ${d.order.shipping_address}</p><p class="text-sm text-gray-500">Address Owner ID: ${d.order.owner_of_address}</p></div></div>`;
        } else {
            html = `<div class="text-center"><div class="text-6xl mb-4">❌</div><h3 class="text-2xl font-black text-gray-900 mb-2">Failed</h3><p class="text-gray-600">${d.message}</p></div>`;
        }
        document.getElementById('result-content').innerHTML = html;
        document.getElementById('result-modal').classList.remove('hidden');
    } catch (e) {
        alert('Network error');
    }
}
</script>