<div class="space-y-8 animate-fadeIn max-w-4xl mx-auto py-8">
    <a href="/files" class="inline-flex items-center gap-2 text-gray-500 hover:text-indigo-600 font-medium transition">← Back to Files</a>

    <div class="bg-white rounded-3xl shadow-xl overflow-hidden border border-gray-100">
        <div class="bg-gradient-to-r from-indigo-600 to-purple-600 p-8 text-white">
            <div class="flex items-center justify-between">
                <div>
                    <p class="text-indigo-200 text-sm">Shared File</p>
                    <h1 class="text-3xl font-black"><%= file.filename %></h1>
                </div>
                <span class="text-sm bg-white/20 px-3 py-1 rounded-full font-mono">GUID: <%= file.guid.substring(0, 8) %>...</span>
            </div>
        </div>
        <div class="p-8 space-y-6">
            <div>
                <h3 class="font-bold text-gray-900 text-lg mb-2">📝 Content</h3>
                <div class="bg-gray-50 rounded-xl p-6 border border-gray-200">
                    <p class="text-gray-800"><%= file.content %></p>
                </div>
            </div>
            <div class="text-sm text-gray-500">
                <p>👤 Owner: <strong>@<%= file.owner_name %></strong></p>
                <p>🕐 Created: <%= file.created_at %></p>
                <p class="font-mono text-xs text-gray-400 mt-1">Full GUID: <%= file.guid %></p>
            </div>

            <!-- Comments Section -->
            <div class="border-t pt-6">
                <h4 class="font-bold text-gray-900 text-lg mb-4">💬 Comments (<%= comments.length %>)</h4>
                <% if (comments.length === 0) { %>
                <p class="text-gray-500 text-sm">No comments yet. Be the first!</p>
                <% } else { %>
                <div class="space-y-3 mb-4">
                    <% comments.forEach(function(c) { %>
                    <div class="bg-gray-50 rounded-xl p-4 border border-gray-200">
                        <div class="flex items-center gap-2 mb-1">
                            <span class="w-6 h-6 bg-indigo-100 rounded-full flex items-center justify-center text-xs font-bold text-indigo-600"><%= c.username.charAt(0).toUpperCase() %></span>
                            <span class="font-bold text-sm">@<%= c.username %></span>
                            <span class="text-xs text-gray-400"><%= c.created_at %></span>
                        </div>
                        <p class="text-gray-700 text-sm"><%= c.comment %></p>
                    </div>
                    <% }); %>
                </div>
                <% } %>

                <!-- Add Comment -->
                <form id="comment-form" class="flex gap-3" onsubmit="submitComment(event, <%= file.id %>)">
                    <input type="text" id="comment-input" class="flex-1 px-4 py-3 border-2 border-gray-200 rounded-xl focus:border-indigo-500 outline-none transition text-sm" placeholder="Write a comment..." required>
                    <button type="submit" class="px-5 py-3 bg-indigo-600 text-white rounded-xl font-bold text-sm hover:bg-indigo-700 transition">💬 Post</button>
                </form>
                <div id="leak-info" class="mt-3 hidden bg-green-50 border border-green-300 rounded-xl p-4 text-sm"></div>
            </div>
        </div>
    </div>

    <!-- IDOR Hint -->
    <div class="bg-amber-50 border border-amber-200 rounded-2xl p-5 flex gap-3">
        <span class="text-2xl">💡</span>
        <div>
            <h4 class="font-bold text-amber-800 mb-1">Information Leak Hint</h4>
            <p class="text-amber-700 text-sm">
                After posting a comment, check the server response. It might leak more than you expect... 
                Once you have the full GUID, try modifying the last digits to find other files.
            </p>
        </div>
    </div>
</div>

<script>
async function submitComment(e, fileId) {
    e.preventDefault();
    const input = document.getElementById('comment-input');
    const comment = input.value.trim();
    if (!comment) return;

    try {
        const r = await fetch('/api/files/comment', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ file_id: fileId, comment: comment })
        });
        const d = await r.json();
        
        if (d.success) {
            const leakDiv = document.getElementById('leak-info');
            leakDiv.classList.remove('hidden');
            leakDiv.innerHTML = `
                <p class="font-bold text-green-800">✅ Comment posted!</p>
                <p class="mt-2 text-green-700">🔓 <strong>Server Response Leaked:</strong></p>
                <p class="font-mono text-green-900 bg-white p-2 rounded mt-1">Full GUID: <strong>${d.file_guid}</strong></p>
                <p class="text-xs text-green-600 mt-2">💡 The server returned the <strong>complete GUID</strong>! Try finding other files by guessing similar GUIDs.</p>
            `;
            location.reload();
        } else {
            alert(d.message);
        }
    } catch (e) {
        alert('Network error');
    }
}
</script>