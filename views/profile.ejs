<div class="space-y-8 animate-fadeIn max-w-5xl mx-auto py-8">
    <% if (typeof success !== 'undefined' && success) { %><div class="bg-green-50 border-l-4 border-green-500 text-green-700 p-4 rounded-xl flex items-center gap-3"><span>✅</span><%= success %></div><% } %>
    <% if (typeof error !== 'undefined' && error) { %><div class="bg-red-50 border-l-4 border-red-500 text-red-700 p-4 rounded-xl flex items-center gap-3"><span>❌</span><%= error %></div><% } %>

    <div class="bg-white rounded-3xl shadow-xl overflow-hidden border border-gray-100">
        <div class="h-32 bg-gradient-to-r from-indigo-600 to-purple-600"></div>
        <div class="px-8 pb-8 -mt-12">
            <div class="w-24 h-24 bg-white rounded-full shadow-xl flex items-center justify-center text-4xl border-4 border-white mb-4">🧑‍💻</div>
            <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
                <div><h2 class="text-3xl font-black text-gray-900">@<%= user.username %></h2><p class="text-gray-500"><%= user.email %></p></div>
                <span class="px-4 py-2 rounded-full text-sm font-bold uppercase <%= user.role==='admin'?'bg-red-100 text-red-700':'bg-indigo-100 text-indigo-700' %>"><%= user.role %></span>
            </div>
        </div>
    </div>

    <div class="bg-white rounded-2xl shadow-lg p-8 border border-gray-100">
        <h2 class="text-2xl font-black text-gray-900 mb-6">📫 My Addresses <span class="text-gray-400 text-base font-normal">(<%= addresses.length %>)</span></h2>
        
        <% if (addresses.length === 0) { %>
        <div class="text-center py-12"><div class="text-6xl mb-4">📭</div><p class="text-gray-500">No saved addresses.</p></div>
        <% } else { %>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-4 mb-8">
            <% addresses.forEach(function(addr) { %>
            <div class="bg-gray-50 rounded-2xl p-5 border-2 border-gray-200 hover:border-red-300 transition-all duration-300 group">
                <div class="text-3xl mb-2"><%= addr.label.split(' ')[0] %></div>
                <h4 class="font-bold text-gray-900"><%= addr.label %></h4>
                <p class="text-gray-600 text-sm mt-1"><%= addr.full_address %></p>
                <% if(addr.city){ %><p class="text-gray-500 text-sm">🏙️ <%= addr.city %><% if(addr.postal_code){ %> - <%= addr.postal_code %><% } %></p><% } %>
                <div class="flex items-center justify-between mt-4 pt-3 border-t border-gray-200">
                    <code class="text-xs text-gray-400 font-mono">ID: <%= addr.id %></code>
                    <button onclick="deleteAddress('<%= addr.id %>')" class="px-4 py-2 bg-white border-2 border-red-200 text-red-600 rounded-xl font-bold text-sm hover:bg-red-500 hover:text-white hover:border-red-500 transition-all duration-200">🗑️ Delete</button>
                </div>
            </div>
            <% }); %>
        </div>
        <% } %>

        <div class="bg-gray-50 rounded-2xl p-6 border-2 border-dashed border-gray-300">
            <h3 class="text-xl font-bold text-gray-900 mb-4">➕ Add New Address</h3>
            <form method="POST" action="/api/address/add" class="space-y-4">
                <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                    <input type="text" name="label" class="w-full px-4 py-3 bg-white border-2 border-gray-200 rounded-xl focus:border-indigo-500 outline-none transition" placeholder="Label (e.g. Home)" required>
                    <input type="text" name="city" class="w-full px-4 py-3 bg-white border-2 border-gray-200 rounded-xl focus:border-indigo-500 outline-none transition" placeholder="City">
                </div>
                <input type="text" name="full_address" class="w-full px-4 py-3 bg-white border-2 border-gray-200 rounded-xl focus:border-indigo-500 outline-none transition" placeholder="Full Address" required>
                <input type="text" name="postal_code" class="w-full px-4 py-3 bg-white border-2 border-gray-200 rounded-xl focus:border-indigo-500 outline-none transition" placeholder="Postal Code">
                <button type="submit" class="w-full py-3 bg-gradient-to-r from-indigo-600 to-purple-600 text-white font-bold rounded-xl hover:shadow-lg transition">💾 Save Address</button>
            </form>
        </div>
    </div>
</div>