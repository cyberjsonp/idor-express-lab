<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Sign In | ShopVault</title>
    <script src="/js/tailwind.play.min.js"></script>
    <link rel="icon" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'><text y='.9em' font-size='90'>🛒</text></svg>">
    <style>
        @keyframes float{0%,100%{transform:translateY(0)}50%{transform:translateY(-10px)}}
        @keyframes slideUp{from{opacity:0;transform:translateY(30px)}to{opacity:1;transform:translateY(0)}}
        @keyframes shake{0%,100%{transform:translateX(0)}25%{transform:translateX(-5px)}75%{transform:translateX(5px)}}
        .animate-float{animation:float 3s ease-in-out infinite}
        .animate-slideUp{animation:slideUp 0.6s ease}
        .animate-shake{animation:shake 0.4s ease}
    </style>
</head>
<body class="min-h-screen flex items-center justify-center bg-gradient-to-br from-slate-900 via-purple-950 to-slate-900 relative overflow-hidden p-4">
    <div class="absolute w-[700px] h-[700px] bg-indigo-600/10 rounded-full -top-60 -right-60 animate-float"></div>
    <div class="absolute w-[500px] h-[500px] bg-purple-600/10 rounded-full -bottom-40 -left-40 animate-float" style="animation-delay: 2s;"></div>
    
    <div class="relative z-10 w-full max-w-5xl bg-white/95 backdrop-blur-xl rounded-3xl shadow-2xl overflow-hidden grid md:grid-cols-2 animate-slideUp">
        <!-- LEFT: BRANDING -->
        <div class="bg-gradient-to-br from-indigo-600 to-purple-700 p-10 md:p-14 flex flex-col justify-center items-center text-white text-center relative overflow-hidden">
            <div class="absolute w-80 h-80 bg-white/5 rounded-full -top-20 -right-20"></div>
            <div class="absolute w-60 h-60 bg-white/5 rounded-full -bottom-16 -left-16"></div>
            <div class="relative z-10">
                <div class="text-8xl mb-6 animate-float">🛒</div>
                <h1 class="text-4xl md:text-5xl font-black mb-4 tracking-tight">ShopVault</h1>
                <p class="text-indigo-100 text-lg mb-10 leading-relaxed">Premium Electronics<br>+ Hidden CTF Lab</p>
                <div class="flex flex-col gap-3 text-indigo-200 text-sm font-medium">
                    <div class="flex items-center gap-3 bg-white/10 rounded-xl px-4 py-2.5"><span>🛍️</span> Realistic Shop Experience</div>
                    <div class="flex items-center gap-3 bg-white/10 rounded-xl px-4 py-2.5"><span>🐛</span> Hidden IDOR Bugs</div>
                    <div class="flex items-center gap-3 bg-white/10 rounded-xl px-4 py-2.5"><span>🏴‍☠️</span> CTF Flags to Capture</div>
                </div>
            </div>
        </div>
        
        <!-- RIGHT: LOGIN -->
        <div class="p-10 md:p-14 flex flex-col justify-center">
            <div class="mb-8">
                <h2 class="text-3xl font-black text-gray-900">Welcome Back 👋</h2>
                <p class="text-gray-500 mt-2 text-lg">Sign in to shop & hack</p>
            </div>
            
            <% if (typeof error !== 'undefined' && error) { %>
            <div class="bg-red-50 border-l-4 border-red-500 text-red-700 p-4 rounded-xl mb-6 animate-shake flex items-center gap-3 font-medium"><span>⚠️</span><%= error %></div>
            <% } %>
            
            <form method="POST" action="/login" class="space-y-5">
                <div>
                    <label class="block text-sm font-bold text-gray-700 uppercase tracking-wider mb-2">👤 Username</label>
                    <div class="relative">
                        <span class="absolute left-4 top-1/2 -translate-y-1/2 text-gray-400">@</span>
                        <input type="text" name="username" class="w-full pl-12 pr-4 py-3.5 bg-gray-50 border-2 border-gray-200 rounded-xl focus:border-indigo-500 focus:bg-white focus:ring-4 focus:ring-indigo-50 outline-none transition font-medium" placeholder="Enter username" required autocomplete="off">
                    </div>
                </div>
                <div>
                    <label class="block text-sm font-bold text-gray-700 uppercase tracking-wider mb-2">🔒 Password</label>
                    <div class="relative">
                        <span class="absolute left-4 top-1/2 -translate-y-1/2 text-gray-400">🔑</span>
                        <input type="password" name="password" class="w-full pl-12 pr-4 py-3.5 bg-gray-50 border-2 border-gray-200 rounded-xl focus:border-indigo-500 focus:bg-white focus:ring-4 focus:ring-indigo-50 outline-none transition font-medium" placeholder="••••••••" required>
                    </div>
                </div>
                <button type="submit" class="w-full py-3.5 bg-gradient-to-r from-indigo-600 to-purple-600 text-white font-bold rounded-xl hover:shadow-xl hover:shadow-indigo-500/25 hover:-translate-y-0.5 transition-all duration-200 text-lg">🚀 Sign In</button>
            </form>
            
            <div class="mt-8 bg-gray-50 rounded-2xl p-5 border-2 border-dashed border-gray-200">
                <h3 class="text-xs font-bold text-gray-500 uppercase tracking-wider mb-3">📝 Test Accounts</h3>
                <table class="w-full text-sm">
                    <thead><tr class="bg-indigo-600 text-white"><th class="py-2.5 px-3 text-left text-xs font-bold uppercase rounded-tl-lg">User</th><th class="py-2.5 px-3 text-left text-xs font-bold uppercase">Pass</th><th class="py-2.5 px-3 text-left text-xs font-bold uppercase rounded-tr-lg">Role</th></tr></thead>
                    <tbody class="bg-white">
                        <tr class="border-b border-gray-100 hover:bg-indigo-50/50 transition"><td class="py-2.5 px-3 font-mono font-semibold">alice</td><td class="py-2.5 px-3 font-mono text-gray-500">password123</td><td class="py-2.5 px-3"><span class="px-2 py-0.5 bg-green-100 text-green-700 rounded-full text-xs font-bold">User</span></td></tr>
                        <tr class="border-b border-gray-100 hover:bg-indigo-50/50 transition"><td class="py-2.5 px-3 font-mono font-semibold">bob</td><td class="py-2.5 px-3 font-mono text-gray-500">password123</td><td class="py-2.5 px-3"><span class="px-2 py-0.5 bg-green-100 text-green-700 rounded-full text-xs font-bold">User</span></td></tr>
                        <tr class="border-b border-gray-100 hover:bg-indigo-50/50 transition"><td class="py-2.5 px-3 font-mono font-semibold">charlie</td><td class="py-2.5 px-3 font-mono text-gray-500">password123</td><td class="py-2.5 px-3"><span class="px-2 py-0.5 bg-green-100 text-green-700 rounded-full text-xs font-bold">User</span></td></tr>
                        <tr class="hover:bg-indigo-50/50 transition"><td class="py-2.5 px-3 font-mono font-semibold">admin</td><td class="py-2.5 px-3 font-mono text-gray-500">admin2024!</td><td class="py-2.5 px-3"><span class="px-2 py-0.5 bg-red-100 text-red-700 rounded-full text-xs font-bold">Admin</span></td></tr>
                    </tbody>
                </table>
            </div>
        </div>
    </div>
    
    <script src="/js/main.js"></script>
</body>
</html>