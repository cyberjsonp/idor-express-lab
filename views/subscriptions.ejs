<div class="space-y-8 animate-fadeIn max-w-4xl mx-auto py-8">
    <div class="flex items-center justify-between">
        <div>
            <h1 class="text-4xl font-black text-gray-900 mb-2">🔔 Notification Settings</h1>
            <p class="text-gray-500">Manage your email and SMS subscriptions</p>
        </div>
    </div>

    <% if (typeof success !== 'undefined' && success) { %><div class="bg-green-50 border-l-4 border-green-500 text-green-700 p-4 rounded-xl"><span>✅</span> <%= success %></div><% } %>
    <% if (typeof error !== 'undefined' && error) { %><div class="bg-red-50 border-l-4 border-red-500 text-red-700 p-4 rounded-xl"><span>❌</span> <%= error %></div><% } %>

    <!-- Current Subscriptions -->
    <div class="bg-white rounded-2xl shadow-lg p-8 border border-gray-100">
        <h2 class="text-2xl font-black text-gray-900 mb-6">📋 Your Subscriptions</h2>
        
        <% if (subscriptions.length === 0) { %>
        <div class="text-center py-12"><div class="text-6xl mb-4">🔕</div><p class="text-gray-500">No subscriptions configured.</p></div>
        <% } else { %>
        <div class="space-y-3">
            <% subscriptions.forEach(function(sub) { %>
            <div class="flex flex-col sm:flex-row sm:items-center justify-between bg-gray-50 rounded-xl p-5 border border-gray-200 gap-4">
                <div class="flex-1">
                    <div class="flex items-center gap-2 mb-1">
                        <code class="text-xs bg-white px-2 py-0.5 rounded font-mono text-gray-400">ID: <%= sub.id %></code>
                    </div>
                    <% if (sub.email) { %><p class="text-gray-700">✉️ <strong><%= sub.email %></strong> <span class="text-xs text-gray-400">(<%= sub.email_enabled ? '✅ Active' : '❌ Disabled' %>)</span></p><% } %>
                    <% if (sub.phone) { %><p class="text-gray-700">📱 <strong><%= sub.phone %></strong> <span class="text-xs text-gray-400">(<%= sub.sms_enabled ? '✅ Active' : '❌ Disabled' %>)</span></p><% } %>
                </div>
                <div class="flex gap-2">
                    <button onclick="editSubscription(<%= sub.id %>, '<%= sub.email || '' %>', '<%= sub.phone || '' %>')" class="px-4 py-2 bg-indigo-50 text-indigo-700 rounded-xl font-bold text-sm hover:bg-indigo-100 transition">✏️ Edit</button>
                    <button onclick="deleteSubscription(<%= sub.id %>)" class="px-4 py-2 bg-red-50 text-red-600 rounded-xl font-bold text-sm hover:bg-red-100 transition">🗑️ Delete</button>
                </div>
            </div>
            <% }); %>
        </div>
        <% } %>
    </div>

    <!-- Add / Edit Subscription Form -->
    <div class="bg-white rounded-2xl shadow-lg p-8 border border-gray-100">
        <h2 class="text-2xl font-black text-gray-900 mb-6" id="form-title">➕ Add Subscription</h2>
        <form id="sub-form" method="POST" action="/api/subscriptions/add" class="space-y-4">
            <input type="hidden" name="_method" value="POST" id="form-method">
            <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                <div>
                    <label class="block text-sm font-bold text-gray-700 mb-2">✉️ Email</label>
                    <input type="email" name="email" id="sub-email" class="w-full px-4 py-3 border-2 border-gray-200 rounded-xl focus:border-indigo-500 outline-none transition" placeholder="you@example.com">
                </div>
                <div>
                    <label class="block text-sm font-bold text-gray-700 mb-2">📱 Phone</label>
                    <input type="tel" name="phone" id="sub-phone" class="w-full px-4 py-3 border-2 border-gray-200 rounded-xl focus:border-indigo-500 outline-none transition" placeholder="+1555123456">
                </div>
            </div>
            <div class="flex gap-6">
                <label class="flex items-center gap-2"><input type="checkbox" name="email_enabled" checked class="w-5 h-5 text-indigo-600 rounded"> Email notifications</label>
                <label class="flex items-center gap-2"><input type="checkbox" name="sms_enabled" class="w-5 h-5 text-indigo-600 rounded"> SMS notifications</label>
            </div>
            <button type="submit" class="px-6 py-3 bg-gradient-to-r from-indigo-600 to-purple-600 text-white font-bold rounded-xl hover:shadow-lg transition">💾 Save</button>
        </form>
    </div>

    <!-- IDOR Hint -->
    <div class="bg-amber-50 border border-amber-200 rounded-2xl p-5 flex gap-3">
        <span class="text-2xl">💡</span>
        <div>
            <h4 class="font-bold text-amber-800 mb-1">Testing Tip</h4>
            <p class="text-amber-700 text-sm">
                Try editing a subscription and intercept the request. What happens if you change the <code class="bg-amber-100 px-1.5 py-0.5 rounded text-amber-800 font-mono text-xs">subscription_id</code> to someone else's ID?
                Use the browser console or Burp Suite to send a PUT request!
            </p>
        </div>
    </div>
</div>

<script>
function editSubscription(id, email, phone) {
    document.getElementById('form-title').textContent = '✏️ Edit Subscription (ID: ' + id + ')';
    document.getElementById('sub-email').value = email;
    document.getElementById('sub-phone').value = phone;
    document.getElementById('form-method').value = 'PUT';
    document.getElementById('sub-form').action = '/api/subscriptions/update';
    
    // اضافه کردن subscription_id مخفی
    let hiddenId = document.getElementById('sub-id');
    if (!hiddenId) {
        hiddenId = document.createElement('input');
        hiddenId.type = 'hidden';
        hiddenId.name = 'subscription_id';
        hiddenId.id = 'sub-id';
        document.getElementById('sub-form').appendChild(hiddenId);
    }
    hiddenId.value = id;
    
    window.scrollTo({ top: document.getElementById('sub-form').offsetTop - 100, behavior: 'smooth' });
}

async function deleteSubscription(id) {
    if (!confirm('Delete this subscription?')) return;
    try {
        const r = await fetch('/api/subscriptions/delete', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ subscription_id: id })
        });
        const d = await r.json();
        if (d.success) location.reload();
        else alert(d.message);
    } catch (e) { alert('Network error'); }
}
</script>