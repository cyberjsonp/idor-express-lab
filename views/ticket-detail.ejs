<div class="space-y-8 animate-fadeIn max-w-4xl mx-auto py-8">
    <a href="/tickets" class="inline-flex items-center gap-2 text-gray-500 hover:text-indigo-600 font-medium transition">← Back to Tickets</a>
    
    <div class="bg-white rounded-3xl shadow-xl overflow-hidden border border-gray-100">
        <div class="bg-gradient-to-r from-indigo-600 to-purple-600 p-8 text-white">
            <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
                <div>
                    <p class="text-indigo-200 text-sm">Ticket Details</p>
                    <h1 class="text-3xl font-black">#TKT-<%= String(ticket.id).padStart(3,'0') %></h1>
                </div>
                <span class="px-4 py-2 rounded-full text-sm font-bold <%= ticket.status==='classified'?'bg-red-500 animate-pulse':'bg-white/20' %>"><%= ticket.status %></span>
            </div>
        </div>
        <div class="p-8 space-y-6">
            <div>
                <h3 class="font-bold text-gray-900 text-lg mb-2"><%= ticket.subject %></h3>
                <p class="text-gray-600"><%= ticket.message %></p>
            </div>
            <div class="flex items-center gap-3 text-sm text-gray-500">
                <span>👤 Owner: <strong>@<%= ticket.owner_name %></strong></span>
                <span>🕐 <%= ticket.created_at || 'Just now' %></span>
            </div>
            
            <!-- Attachments -->
            <div class="border-t pt-6">
                <h4 class="font-bold text-gray-900 text-lg mb-4">📎 Attachments (<%= attachments.length %>)</h4>
                <% if (attachments.length === 0) { %>
                <p class="text-gray-500">No attachments.</p>
                <% } else { %>
                <div class="space-y-2">
                    <% attachments.forEach(function(att) { %>
                    <div class="flex items-center justify-between bg-gray-50 rounded-xl p-4 hover:bg-indigo-50 transition">
                        <div class="flex items-center gap-3">
                            <span class="text-2xl">📄</span>
                            <div>
                                <p class="font-bold text-gray-900 text-sm"><%= att.filename %></p>
                                <p class="text-xs text-gray-500">ID: <%= att.id %> | <%= att.uploaded_at %></p>
                            </div>
                        </div>
                        <a href="/attachments/download/<%= att.id %>" class="px-4 py-2 bg-indigo-600 text-white rounded-xl font-bold text-sm hover:bg-indigo-700 transition">⬇️ Download</a>
                    </div>
                    <% }); %>
                </div>
                <% } %>
            </div>
        </div>
    </div>

    <% if (ticket.owner_name !== user.username) { %>
    <div class="bg-amber-50 border-2 border-amber-300 rounded-2xl p-6 flex gap-4">
        <span class="text-4xl">⚠️</span>
        <div><h3 class="font-black text-amber-800 text-lg">IDOR Detected!</h3><p class="text-amber-700">You're viewing <strong>@<%= ticket.owner_name %>'s</strong> ticket. Try downloading their attachments too!</p></div>
    </div>
    <% } %>
</div>