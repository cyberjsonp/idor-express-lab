<div class="min-h-[70vh] flex items-center justify-center animate-fadeIn">
    <div class="text-center bg-white rounded-3xl shadow-xl p-12 max-w-md">
        <div class="text-8xl mb-6"><% if(error&&error.status===404){ %>🔍<% }else if(error&&error.status===403){ %>🚫<% }else{ %>⚠️<% } %></div>
        <h1 class="text-3xl font-black text-gray-900 mb-3"><% if(error&&error.status===404){ %>404 Not Found<% }else if(error&&error.status===403){ %>403 Forbidden<% }else{ %>Oops!<% } %></h1>
        <p class="text-gray-500 mb-8"><%= message %></p>
        <% if(typeof error!=='undefined'&&error.stack){ %><details class="text-left mb-6"><summary class="cursor-pointer text-red-500 font-bold">🔧 Details</summary><pre class="mt-3 bg-gray-900 text-green-400 p-4 rounded-xl text-xs overflow-x-auto"><%= error.stack %></pre></details><% } %>
        <a href="/dashboard" class="inline-block px-8 py-3 bg-gradient-to-r from-indigo-600 to-purple-600 text-white font-bold rounded-xl hover:shadow-lg transition">🏠 Go Home</a>
    </div>
</div>